# ============================================
# CLIENT-SIDE ENV (bundled into Flutter app)
# ============================================
# JANGAN masukkan API key sensitif di sini!
# File ini di-bundle ke dalam APK/Web build.

# Verysense API URL (untuk ML backend)
VERYSENSE_API_URL=http://localhost:5000

# ============================================
# SERVER-SIDE ENV (hanya di server/.env)
# ============================================
# Set via environment variable sistem, BUKAN di file ini.
# export GEMINI_API_KEY=your_gemini_api_key_here
